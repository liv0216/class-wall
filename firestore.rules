rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // [교사(teacher) 확인 함수]
    // 1) 선생님 구글 계정(liv0216@gmail.com)이거나
    // 2) 교사 UID 목록에 포함되어 있거나
    // 3) users 컬렉션에 role이 'teacher'로 등록된 경우
    function isTeacher() {
      return request.auth != null && (
        request.auth.token.email == 'liv0216@gmail.com'
        || request.auth.uid in [
          'TEACHER_UID_HERE'
        ]
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher')
      );
    }

    // [학생(student) 확인 함수]
    function isStudent() {
      return request.auth != null;
    }

    match /memos/{memoId} {
      // 1. [읽기] 누구나 담벼락의 메모를 볼 수 있습니다.
      allow read: if true;

      // 2. [생성]
      // - 교사: 모든 메모 생성 가능
      // - 학생: 오직 본인의 UID로만 생성 가능 (5글자 이상 필수)
      allow create: if request.auth != null
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 5
                    && (isTeacher() || (isStudent() && request.resource.data.uid == request.auth.uid));

      // 3. [삭제]
      // - 교사(teacher): 모든 메모를 삭제할 수 있는 전권 부여
      // - 학생(student): 타인의 메모는 건들 수 없고, 본인 메모만 삭제 가능
      allow delete: if isTeacher()
                    || (request.auth != null && (resource.data.uid == request.auth.uid || !('uid' in resource.data)));

      // 4. [수정]
      // - 교사만 수정 가능하며, 학생은 타인의 것은 건들지 못합니다.
      allow update: if isTeacher();
    }

    // 사용자 역할/정보 저장 컬렉션
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isTeacher() || (request.auth != null && request.auth.uid == userId);
    }
  }
}
