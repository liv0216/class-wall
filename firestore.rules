rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // [교사(teacher) 확인 함수]
    // 1) 선생님 구글 계정(liv0216@gmail.com)이거나
    // 2) 교사 UID 목록에 포함되어 있거나
    // 3) users 컬렉션에 role이 'teacher'로 등록된 경우
    function isTeacher() {
      return request.auth != null && (
        request.auth.token.email == 'liv0216@gmail.com'
        || request.auth.uid in [
          'TEACHER_UID_HERE'
        ]
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher')
      );
    }

    // [학생(student) 확인 함수]
    function isStudent() {
      return request.auth != null;
    }

    // 1. [담벼락 보드 컬렉션]
    match /boards/{boardId} {
      // 누구나 보드 정보(이름, 잠금 상태 등)를 읽을 수 있습니다.
      allow read: if true;
      // 보드 생성, 수정(잠금 토글 설정 등), 삭제는 교사만 가능합니다.
      allow write: if isTeacher();
    }

    // 2. [메모 컬렉션]
    match /memos/{memoId} {
      // [읽기] 누구나 담벼락의 메모를 볼 수 있습니다.
      allow read: if true;

      // [생성] 로그인한 사용자(학생은 본인 UID 명시, 5글자 이상)
      allow create: if request.auth != null
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 5
                    && (isTeacher() || (isStudent() && request.resource.data.uid == request.auth.uid));

      // [삭제] 교사는 모든 메모 삭제 가능, 학생은 본인이 쓴 메모만 삭제 가능
      allow delete: if isTeacher()
                    || (request.auth != null && (resource.data.uid == request.auth.uid || !('uid' in resource.data)));

      // [수정] 교사는 전권 수정 가능, 학생은 반응(이모지) 및 댓글 참여를 위해 수정 가능
      allow update: if isTeacher() || request.auth != null;
    }

    // 3. [사용자 역할/정보 저장 컬렉션]
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isTeacher() || (request.auth != null && request.auth.uid == userId);
    }
  }
}
